{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["src/main/**/*", "src/preload/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "out"]
}
