{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": ["src/renderer/**/*", "shared/**/*", "env.d.ts"],
  "exclude": ["node_modules", "dist", "out"]
}
